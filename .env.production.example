# Copy this file to the production secret manager and replace every value marked CHANGE_ME.
PORT=4000
NODE_ENV=production
WEB_ORIGIN=https://CHANGE_ME.example.kz
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/yasawi_startup?schema=public
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=true
IP_HASH_SALT=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SWAGGER_ENABLED=false
TRUST_PROXY=true

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=https://your-production-domain.kz
API_INTERNAL_URL=http://127.0.0.1:4000
PUBLIC_API_URL=https://CHANGE_ME.example.kz

AYU_NEWS_SOURCE_URL=https://ayu.edu.kz/birimler/ru/310-ticarilestirme-ofisi/
AYU_NEWS_TIMEOUT_MS=20000
AYU_NEWS_REQUEST_ATTEMPTS=3
NEWS_CACHE_TTL_MS=1800000

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Yasawi Startup <no-reply@CHANGE_ME.example.kz>
REQUIRE_SMTP=true

S3_BUCKET=CHANGE_ME
S3_REGION=auto
S3_ENDPOINT=https://CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_URL=https://CHANGE_ME
S3_FORCE_PATH_STYLE=false
REQUIRE_S3=true
