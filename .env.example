# NestJS API
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://yasawi:yasawi_local_password@localhost:5432/yasawi_startup?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ADMIN_SEED_EMAIL=admin@yasawi.local
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=false
IP_HASH_SALT=replace-with-at-least-32-random-characters
SWAGGER_ENABLED=true
TRUST_PROXY=false

# Next.js frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Автоматические новости с официального сайта AYU
AYU_NEWS_SOURCE_URL=https://ayu.edu.kz/birimler/ru/310-ticarilestirme-ofisi/
AYU_NEWS_TIMEOUT_MS=20000
AYU_NEWS_REQUEST_ATTEMPTS=3
NEWS_CACHE_TTL_MS=1800000

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Yasawi Startup <no-reply@yasawi.local>
REQUIRE_SMTP=false

# Uploaded images. PUBLIC_API_URL is used to build public media URLs.
MEDIA_ROOT=uploads
PUBLIC_API_URL=http://localhost:4000

# Optional S3-compatible storage (production)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
REQUIRE_S3=false
